{
  "manifest_version": 3,
  "name": "ORCA LINK · DeepSeek 官网皮肤",
  "version": "0.1.4",
  "description": "把 DSH 的「虎鲸链路 / ORCA LINK」皮肤搬到 chat.deepseek.com：亮暗双场景动态背景、全局直角契约与状态角色。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "ORCA LINK",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/orca.js"],
      "css": ["src/orca.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ]
}
